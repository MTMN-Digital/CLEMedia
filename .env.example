# Supabase, public, safe in the browser bundle
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase, SERVER ONLY. Never prefixed VITE_, never in the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe, test keys until the client supplies live ones
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Site
VITE_SITE_URL=https://example.com
VITE_SHOW_SITE_URL=https://www.pawsitivepugs.com

# Email notifications for enquiries
RESEND_API_KEY=
ENQUIRY_NOTIFY_TO=
# The sender. Must be an address on a domain verified in Resend, or every
# notification is rejected and nobody is told an enquiry arrived.
# Example: CLE Family Media <notifications@clefamilymedia.ie>
ENQUIRY_NOTIFY_FROM=
