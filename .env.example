# Supabase, public, safe in the browser bundle
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase, SERVER ONLY. Never prefixed VITE_, never in the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe, test keys until the client supplies live ones
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Site
VITE_SITE_URL=https://example.com
VITE_SHOW_SITE_URL=https://www.pawsitivepugs.com

# Email notifications for enquiries
RESEND_API_KEY=
ENQUIRY_NOTIFY_TO=
# The sender. Must be an address on a domain verified in Resend, or every
# notification is rejected and nobody is told an enquiry arrived.
# Example: CLE Family Media <notifications@clefamilymedia.ie>
ENQUIRY_NOTIFY_FROM=

# The cross-border case study's educator questionnaire. Anything but the exact
# string "true" is closed, and a missing value is closed, so a fresh
# environment never collects a response by accident. Set this to true only
# once the participant information is published and the handling of responses
# is agreed with CLE. See api/study-response.ts and migration 0007.
STUDY_OPEN=false
